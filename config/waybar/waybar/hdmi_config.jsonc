// HDMI waybar config
{
    "name": "external-bar",
    "output": "HDMI-A-1",
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "mode": "dock",
    "height": 42, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 3, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "hyprland/window",
        "pulseaudio",
        "backlight",
        "backlight#screenpad"
    ],
    "modules-center": [
        "custom/sysinfo"
    ],
    "modules-right": [
        "idle_inhibitor",
        "network",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "battery#bat2",
        "clock#hdmi"
    ],
    //Modules configuration

    "include": [
        "~/.config/waybar/modules.json"
    ],

    //Clock overide
    "clock#hdmi": {
        "interval": 1,
        "format": "{:%I:%M:%S %p | %A, %B %d, %Y}", // Your expanded format here
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    }
},
